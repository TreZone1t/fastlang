{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FastLang",
  "scopeName": "source.fast",
  "fileTypes": ["fast", "fs"],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#function_definition"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#function_call"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fast",
          "match": "//.*$"
        },
        {
          "name": "comment.block.fast",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fast",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.fast",
              "match": "\\\\([nrtbf\\\\\"0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        },
        {
          "name": "string.quoted.single.fast",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.fast",
              "match": "\\\\([nrtbf\\\\'0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.fast",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "function_definition": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.fast" },
            "2": { "name": "entity.name.function.fast" }
          }
        },
        {
          "match": "\\b(class|struct|blueprint|custom|block|micro|enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.fast" },
            "2": { "name": "entity.name.type.class.fast" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fast",
          "match": "\\b(if|else|while|do|for|in|loop|break|continue|return|yield|leave|goto|match|switch|case|try|catch|throw|del|using|export|import|use)\\b"
        },
        {
          "name": "keyword.declaration.fast",
          "match": "\\b(fn|class|struct|blueprint|custom|block|micro|enum|impl|handle|init|constructor|let|const|set|new|flag)\\b"
        },
        {
          "name": "keyword.other.visibility.fast",
          "match": "\\b(public|private|static|enable|restricted|extends)\\b"
        },
        {
          "name": "constant.language.boolean.fast",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.this.fast",
          "match": "\\b(this|default)\\b"
        },
        {
          "name": "support.constant.enum.variant.fast",
          "match": "\\b(Some|None)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.fast",
          "match": "\\b(int|int8|int16|int32|int64|int128|float|float32|float64|float128|bool|char|void|string|type)\\b"
        },
        {
          "name": "entity.name.type.smartptr.fast",
          "match": "\\b(name|modify|copy|scope|flag|param|Fn|method)\\b"
        },
        {
          "name": "entity.name.type.userdefined.fast",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.fast",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.fast",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.float.fast",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.fast",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "function_call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.fast" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.fast",
          "match": "(->|=>|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|&&|\\|\\||\\+|-|\\*|/|%|<|>|=|!)"
        }
      ]
    }
  }
}
