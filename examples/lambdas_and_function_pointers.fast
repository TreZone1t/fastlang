// FastLang Example: Smart Function Pointers, Lambdas & Higher-Order Functions (.fast)

fn add(x: int32, y: int32) -> int32 {
    return x + y;
}

fn multiply(x: int32, y: int32) -> int32 {
    return x * y;
}

// Higher-Order Function that accepts a function pointer
fn compute(a: int32, b: int32, operation: name<Fn<(int32, int32), int32>>) -> int32 {
    return operation(a, b);
}

fn main() -> int32 {
    // 1. Storing named functions in smart function pointers
    name<Fn<(int32, int32), int32>> my_op = add;
    println("Add via pointer: ", my_op(10, 20));

    // 2. Reassignment using 'set'
    set my_op = multiply;
    println("Multiply via pointer: ", my_op(10, 20));

    // 3. Anonymous Lambda functions
    name<Fn<(int32, int32), int32>> subtract = fn _(a: int32, b: int32) -> int32 {
        return a - b;
    };
    println("Lambda subtract: ", subtract(50, 15));

    // 4. Passing functions & lambdas to Higher-Order Functions
    int32 res1 = compute(6, 7, multiply);
    println("Compute with multiply: ", res1);

    int32 res2 = compute(100, 25, subtract);
    println("Compute with lambda: ", res2);

    return 0;
}
