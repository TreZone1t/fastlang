// FastLang Example: Smart Pointers & Memory Management (.fast)

class User -> {
    public -> {
        int32 id = 0;
        str username = "";
    }
    constructor -> {
        init(id: int32, username: str) -> {
            this.id = id;
            this.username = username;
        }
    }
    handle -> {
        fn drop() -> void {
            println("User dropped");
        }
    }
}

fn main() -> int32 {
    println("=== 1. Heap Allocation with new ===");
    User user = new User(1, "Abdulhakim");
    println("User ID: ", user.id);
    println("User Name: ", user.username);

    println("=== 2. Smart Pointers (ref<T> and mutRef<T>) ===");
    int32 val = 100;
    ref<int32> read_ptr = &val;
    println("Read via pointer: ", *read_ptr);

    mutRef<int32> mod_ptr = &val;
    mod_ptr += 50;
    println("Updated value: ", val);

    print("=== 3. Dynamic Heap Arrays ===");
    int32* heap_arr = new int32[](3);
    heap_arr[0] = 10;
    heap_arr[1] = 20;
    heap_arr[2] = 30;
    println("Heap item: ", heap_arr[1]);

    print("=== 4. Dynamic Cleanup with del ===");
    del user;

    return 0;
}
