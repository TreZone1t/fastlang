// FastLang Standard Library: coroutine

public class go -> {
    public -> {
        int32 capacity = 10;
    }

    constructor -> {
        init(cap: int32) -> {
            this.capacity = cap;
        }
        init(task: method<void>) -> {
            while(!task.is_done){
                task();
            }
            this.is_done = true;
        }
    }

    handle -> {
        fn call(task: method<void>) -> void {
            while(!task.is_done){
                task();
            }
            this.is_done = true;
        }
        fn call(task: method<int32>) -> int32 {
             int32 res;
            while(!task.is_done){
                res = task();
            }
            this.is_done = true;
            return res;
        }
    }
}
