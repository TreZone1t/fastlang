// Standard Library: List utilities
// using the scope system to define behavior

public class node<T> -> {
    private -> {
        T value;
        Option<modify<node<T>>> next = None;
        int i = 0;
    }
    public -> {
        fn get_value() -> T {
            return this.value;
        }
        fn set_value(v: T) -> void {
            this.value = v;
        }
        fn get_next() -> Option<modify<node<T>>> {
            return this.next;
        }
        fn set_next(n: Option<name<node<T>>>) -> void {
            this.next = n;
        }
        fn as_str() -> str {
            return "{ value: " + this.value + ", next: " + this.next.as_str() + " }";
        }
    }
    constructor -> {
        init(v: T) -> {
            this.value = v;
            this.next = None;
        }
    }
    handle -> {
        fn drop() -> void {
            if (this.next.is_Some()) {
                del this.next;
            }
        }
        fn display() -> char[] {
            return this.as_str();
        }
    }
}

public class list<T> -> {
    private -> {
        Option<modify<node<T>>> head = None;
        Option<modify<node<T>>> current = None;
        int32 length = 0;
    }
    public -> {
      fn set_head(node_ptr: Option<name<node<T>>>) -> void {
        if (this.head.is_Some()) {
            del this.head;
        }
        this.head = node_ptr;
        this.length = this.length + 1;
      }
      fn get_head() -> Option<modify<node<T>>> {
        return this.head;
      }
      fn push(item: T) -> void {
        match (this.head) -> {
          None => {
            this.head = Some(new node<T>(item));
            this.length = this.length + 1;
          }
          Some(h) => {
            modify<node<T>> new_node = new node<T>(item);
            new_node.set_next(Some(h));
            this.head = Some(new_node);
            this.length = this.length + 1;
          }
        }
      }
      fn pop() -> Option<copy<T>> {
        match (this.head) -> {
          Some(h) => {
            modify<node<T>> temp = h;
            this.head = temp.get_next();
            copy<T> val = temp.get_value();
            del temp;
            this.length = this.length - 1;
            return Some(val);
          }
          None => {
            return None;
          }
        }
      }
      fn extend_from_array(arr: T[]) -> void {
        for (int32 i = 0; i < arr.length; i = i + 1) -> {
          this.push(arr[i]);
        }
      }
      fn size() -> int32 {
        return this.length;
      }
    }
    handle -> {
      fn arrow(arr: T[]) -> void {
        this.extend_from_array(arr);
      }
      fn arrow_assign(arr: T[]) -> void {
        this.extend_from_array(arr);
      }
      fn iterator() -> void {
        this.current = this.head;
      }
      fn next() -> Option<copy<T>> {
        match (this.current) -> {
          None => {
            return None;
          }
          Some(c) => {
            copy<T> val = c.get_value();
            this.current = c.get_next();
            return Some(val);
          }
        }
      }
      fn drop() -> void {
          del this.head;
          if(this.current.is_Some()){
            del this.current;
          }
      }
      fn display() -> char[] {
          return "{ head: " + this.head.as_str() + ", length: " + this.length + " }";
      }
    }
    constructor -> {
      init() -> {
        this.head = None;
        this.current = None;
        this.length = 0;
      }
      init(arr: T[]) -> {
        this.head = None;
        this.current = None;
        this.length = 0;
        this.extend_from_array(arr);
      }
    }
}




