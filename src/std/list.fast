// Standard Library: List utilities
// using the scope system to define behavior

export class node<T> -> {
    private -> {
        T value;
        Option<name<node<T>>> next = None;
        int i = 0;
    }
    public -> {
        fn get_value() -> T {
            return this.value;
        }
        fn set_value(v: T) -> void {
            this.value = v;
        }
        fn get_next() -> Option<name<node<T>>> {
            return this.next;
        }
        fn set_next(n: Option<name<node<T>>>) -> void {
            this.next = n;
        }
    }
    constructor -> {
        init(v: T) -> {
            this.value = v;
            this.next = None;
        }
    }
}

export class list<T> -> {
    private -> {
        Option<name<node<T>>> head = None;
        Option<name<node<T>>> current = None;
        int32 length = 0;
    }
    public -> {
      fn set_head(node_ptr: Option<name<node<T>>>) -> void {
        this.head = node_ptr;
        this.length = this.length + 1;
      }
      fn get_head() -> Option<name<node<T>>> {
        return this.head;
      }
      fn push(item: T) -> void {
        match (this.head) -> {
          None => {
            this.head = Some(new node<T>(item));
            this.length = this.length + 1;
          }
          Some(h) => {
            modify<node<T>> new_node = new node<T>(item);
            new_node.set_next(Some(h));
            this.head = Some(new_node);
            this.length = this.length + 1;
          }
        }
      }
      fn pop() -> copy<T> {
        match (this.head) -> {
          Some(h) => {
            modify<node<T>> temp = h;
            this.head = temp.get_next();
            copy<T> val = temp.get_value();
            del temp;
            this.length = this.length - 1;
            return val;
          }
          None => {
            return default();
          }
        }
      }
      fn extend_from_array(arr: T[]) -> void {
        for (int32 i = 0; i < arr.length; i = i + 1) -> {
          this.push(arr[i]);
        }
      }
      fn size() -> int32 {
        return this.length;
      }
    }
    handle -> {
      fn arrow(arr: T[]) -> void {
        this.extend_from_array(arr);
      }
      fn arrow_assign(arr: T[]) -> void {
        this.extend_from_array(arr);
      }
      fn iterator() -> void {
        this.current = this.head;
      }
      fn next() -> Option<copy<T>> {
        match (this.current) -> {
          None => {
            return None;
          }
          Some(c) => {
            copy<T> val = c.get_value();
            this.current = c.get_next();
            return Some(val);
          }
        }
      }
    }

    constructor -> {
      init() -> {
        this.head = None;
        this.current = None;
        this.length = 0;
      }
      init(arr: T[]) -> {
        this.head = None;
        this.current = None;
        this.length = 0;
        this.extend_from_array(arr);
      }
    }
}




