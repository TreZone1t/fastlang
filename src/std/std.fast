// FastLang Standard Library: Core Prelude, Option & Base Types
import std::error;
import std::io;
import std::string;
import std::range;

public enum Option<T> -> {
    Some(T),
    None,
}

impl handle for Option -> {
    fn default() -> Option<T> {
        return Option::None;
    }
}

public micro stop = ()-> {
    break;
}

public @compile -> {

    set typeof<T>(T) -> type;
    set sizeof<T>(T) -> uint32;
    set rand<T>() -> T;
    set rand<T>(T) -> T;
    set rand<T>(T, T) -> T;
    set rand<T>(T, T, T) -> T;
    set print<...T>(...T) -> void;
    impl type<T> -> {
        set printable() -> bool;
        set is_pointer() -> bool;
        set is_array() -> bool;
        set is_primitive() -> bool;
        set throwable() -> bool;
        set copyable() -> bool;
        set as_str() -> str;
        set default() -> T;
        set castable() -> bool;
        set castable_to(type) -> bool;
        set size() -> uint32;
    }

    method cast<Target, Source>(val: Source) -> Target {
        if (!Source.is_primitive()) {
            throw new Error("casting not supported for non primitive types");
        }
        if (!Target.is_primitive()) {
            throw new Error("target type is not a primitive type");
        }
        if (Source.castable_to(Target)) {
            return val as Target;
        } else {
            throw new Error("Type " + Source.as_str() + " cannot be casted to " + Target.as_str());
        }
    }

}

// cast wrapper
public method cast<Target, Source>(val: Source) -> Target {
    return @compile::cast<Target>(val);
}

public method typeof<T>(val: T) -> type {
    return @compile::typeof(val);
}

public method sizeof<T>(val: T) -> uint32 {
    return @compile::sizeof(val);
}

public fn rand<T>() -> T {
    return @compile::rand<T>();
}

public fn rand<T>(max: T) -> T {
    return @compile::rand<T>(max);
}

public fn rand<T>(min: T, max: T) -> T {
    return @compile::rand<T>(min, max);
}

public fn rand<T>(min: T, max: T, step: T) -> T {
    return @compile::rand<T>(min, max, step);
}

public method deepCopy<T>(val: T) -> modify<T> {
    copy<T> temp = val;
    return temp;
}

public impl str -> {
    handle -> {
        fn default() -> str {
            return "";
        }
    }
    fn is_empty() -> bool {
        return this.len == 0;
    }

    fn first() -> Option<char> {
        if (this.len == 0) {
            return None;
        }
        return Some(this[0]);
    }

    fn last() -> Option<char> {
        if (this.len == 0) {
            return None;
        }
        return Some(this[this.len - 1]);
    }
}

public impl char -> {
    handle -> {
        fn default() -> char {
            return ' ';
        }
    }
    fn is_digit() -> bool {
        return this >= '0' && this <= '9';
    }

    fn is_alpha() -> bool {
        return (this >= 'a' && this <= 'z') || (this >= 'A' && this <= 'Z');
    }

    fn is_alphanumeric() -> bool {
        return (this >= 'a' && this <= 'z') || (this >= 'A' && this <= 'Z') || (this >= '0' && this <= '9');
    }

    fn is_whitespace() -> bool {
        return this == ' ' || this == '\t' || this == '\n' || this == '\r';
    }

    fn to_upper() -> char {
        if (this >= 'a' && this <= 'z') {
            return this - 'a' + 'A';
        }
        return this;
    }

    fn to_lower() -> char {
        if (this >= 'A' && this <= 'Z') {
            return this - 'A' + 'a';
        }
        return this;
    }
}

public impl array<T> -> {
    handle -> { 
        fn default() -> T[] {
            T arr[] = new T[this.len || 0];
            for (int32 i = 0; i < this.len; i = i + 1) {
                arr[i] = ();
            }
            return arr;
        }
    }
    fn is_empty() -> bool {
        return this.len == 0;
    }

    fn first() -> Option<T> {
        if (this.len == 0) {
            return None;
        }
        return Some(this[0]);
    }

    fn last() -> Option<T> {
        if (this.len == 0) {
            return None;
        }
        return Some(this[this.len - 1]);
    }

    fn map(transform: lambda<(T) -> T>) -> void {
        for (int32 i = 0; i < this.len; i = i + 1) {
            this[i] = transform(this[i]);
        }
    }
    // todo: chain test in for in
 fn chain(other: T[]) -> T[] {
    return [...this, ...other];
}
}