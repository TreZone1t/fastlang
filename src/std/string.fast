// FastLang Standard Library: string
export class string -> {
    private -> {
        char[] buffer = []; //we will use list in future not array.
        int32 length = 0;
    }

    public -> {
        fn get_buffer() -> char[] {
            return this.buffer;
        }
        fn size() -> int32 {
            return this.length;
        }
    }

    handle -> {
        fn display() -> {
            return this.buffer;
        }
        fn arrow(arr: char[]) -> void {
            this.buffer = arr;
            this.length = arr.length;
        }
        fn arrow_assign(arr: char[]) -> void {
            this.buffer = arr;
            this.length = arr.length;
        }
        fn index_access(index: int32) -> char {
            return this.buffer[index];
        }
    }

    constructor -> {
        init() -> {
            this.length = 0;
        }
        init(arr: char[]) -> {
            this.buffer = arr;
            this.length = arr.length;
        }
    }
}
