// also we need to set the setting of th drop micro and freeze micro
// first : drop micro
// it will drop all the vars in the scope like rust drop
// so we will delete the ptrs and the names (smart ptrs) and we will call the drop handle for the objects
// so in a block like this
//  xb {
//     int* x = new int(10);
//     int y = 20;
// modify xz = new X(10,20);
// return x + y;
// }
// when we call the block it will drop the ptrs and the names after the return 
// int res =  xb(); // that will drop the ptrs and the names
// so first also we need to set how the names are dropped
// the name is ref that not increase the ref count
// but modify is ref that increase the ref count
// and copy create a new modify ref that increase the ref count (1 ref)
// so when we try to drop a modify ref it will decrease the ref count
// and when we try to drop a copy ref it will decrease the ref count
// and when we try to drop a name ref it will be not allowed 
// so actually we will built name and modify and copy impl in std.fast as the other types
// and they will have drop handle
// but the way we store their data will need to be set how we will know the Rc and that stuff
// that all for the drop micro
// for the freeze micro
// it will take a name ref and freeze it 
// and it will work under the hood or we will actually make it in the std.fast
// also i think we need to enhance the iterator handle and the next handle
// so first iterator is very long name so it be iter not iterator like python
// also i what to make a iter handle return a name ref to a Object that have ({ data , next() , is_done })
// for that Obj we may make it using blueprints and their impl
// so we can do this
 micro iter<T> = (arr: name<T>) -> name<T> {
    return arr.iterator();
 };
 // and to use it we will do this
itr := iter(arr7);
 while(!itr.is_done) {
    print(itr.next());
 }

// or that will work also
 for ele in iter(arr7) {
    print(ele)
 }
