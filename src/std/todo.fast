// we will add a compile time block to be able to do this
@compile {
    // also we will allow to create a macro like throw 
    // that will be like that
    // every thing we we by set or new
    // so to create a macro we will do this
    new $throw[e:Error] -> {
        throw e;
    }
    // []  means what comes after the macro name
    // like this
    // @compile::throw new Error("hi from compile time");
    // but to use a @compile block we to make sure every thing is compile time
    set $throw[e:Error] -> {
        throw e;
    }
    // we may use $ or # or ~ or `name` we need to decide
}
// so this an example of compile time error
@compile::throw new Error("hi from compile time");
// and this an example of compile time check type in print
fn print<...T>(...args:...T){
    for arg in args {
    if(typeof(arg).printable){  // that is only to explaining the .. part

    fast_print(arg);
    }else{
     @compile::throw new Error("there is non printable type in the args : ("arg")");
    }
}
}
