// also to explain how the stop suppose to work
impl array {
    fn iterator() -> void {
        this.count := 0;
    }
      fn next() -> modify<T,micro> { 
        if(this.count >= this.length) return stop; // i think the con is wrong but you get it
         this.count += 1;
          return array[this.count - 1];
      }
}
