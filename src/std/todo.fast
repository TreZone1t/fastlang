// also we need to separated and gather vars in params
// also a cool feature we need is to allow the fn to have it own generic it will be calculated in compiler time for each arg if the type is ..
// also we need to add ..T for all generics
fn print<..T>(..args:..T){
    for arg in args {
    if(typeof(arg).printable){  // that is only to explaining the .. part
    // we will handle the printable part in the compiler
    // also actually we will allow the user to code some thing like (typeof(arg).printable) 
    // witch will update in compiler time if the user add the display handle in the code for the arg
    fast_print(arg);
    }else{
     throw new Error("there is non printable type in the args : ("arg")");
     continue;
    }
}
}
