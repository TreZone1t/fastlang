// FastLang Standard Library: FastReact (FR) Web Layer
import std::net;
import std::http;
import std::types;
import std::fmt;

using http;

set web;

public fn make_action(target: str, swap: str, content: HtmlDocument) -> WebAction {
    return action(target, swap, content);
}

public fn make_action(target: str, content: HtmlDocument) -> WebAction {
    return action(target, content);
}
