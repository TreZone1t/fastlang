// Comprehensive Suite 02: Control Flow, Conditions, While, Do-While, For-In, and Custom Iterators

blueprint NumberListIter -> {
    int32 items[];
    int32 count;
    int32 limit;
}

impl NumberListIter -> {
    handle -> {
        fn is_done_iter() -> bool {
            return this.count >= this.limit;
        }
        fn next() -> int32 {
            this.count += 1;
            return this.items[this.count - 1];
        }
    }
}

class NumberList -> {
    private -> {
        int32 items[5] = [10, 20, 30, 40, 50];
        int32 limit = 3;
    }
    public -> {
        fn set_limit(l: int32) -> void {
            this.limit = l;
        }
    }
    handle -> {
        fn iter() -> NumberListIter {
            NumberListIter it;
            it.items = this.items;
            it.count = 0;
            it.limit = this.limit;
            return it;
        }
    }
    constructor -> {
        init(l: int32) -> {
            this.limit = l;
        }
    }
}
/* 
// that will generate a fn with only result in it and will return 0; for all 
// the right is all of the check_score consider as a compile time function 
fn check_score(score: int32) -> int32 {
    int result = 0;
    @compile {
    if (score >= 90) {
        result = 1;
    } else if (score >= 75) {
        result = 2;
    } else if (score >= 50) {
        result = 3;
    } else {
      result = 4;
    }
}(result , score);
    return result;
}
*/
@compile {
    fn check_score(score: int32) -> int32 {
        if (score >= 90) {
            return 1;
        } else if (score >= 75) {
            return 2;
        } else if (score >= 50) {
            return 3;
        } else {
            return 4;
        }
    }
}

fn test_conditions() -> void {
    int32 c1 = @compile::check_score(95);
    int32 c2 = @compile::check_score(80);
    int32 c3 = @compile::check_score(60);
    int32 c4 = @compile::check_score(40);
    println("Conditions: ", c1, " ", c2, " ", c3, " ", c4); // EXPECT: Conditions: 1 2 3 4
}

fn test_while_loops() -> void {
    int32 count = 0;
    int32 sum = 0;
    while (count < 5) {
        count += 1;
        if (count == 3) {
            continue;
        }
        sum += count;
    }
    println("While sum (skip 3): ", sum); // EXPECT: While sum (skip 3): 12
}

fn test_do_while_loops() -> void {
    int32 count = 0;
    int32 sum = 0;
    do -> {
        count += 1;
        sum += count;
    } while (count < 5);
    println("DoWhile sum: ", sum); // EXPECT: DoWhile sum: 15

    int32 val = 10;
    int32 iterations = 0;
    do {
        iterations += 1;
        val -= 2;
        if (val <= 4) {
            break;
        }
    } while (val > 0);
    println("DoWhile break iter: ", iterations); // EXPECT: DoWhile break iter: 3
}

fn test_for_in_and_iterators() -> void {
    int32 nums[] = [100, 200, 300];
    for n in nums {
        println(n);
    }
    // EXPECT: 100
    // EXPECT: 200
    // EXPECT: 300

    NumberList list1 = new NumberList(3);
    for x in list1 -> {
        println(x);
    }
    // EXPECT: 10
    // EXPECT: 20
    // EXPECT: 30
}

fn test_raw_and_counted_loops() -> void {
    int32 count_accum = 0;
    loop 5 -> {
        count_accum += 1;
    }
    println("Counted loop result: ", count_accum); // EXPECT: Counted loop result: 5

    int32 raw_val = 0;
    loop -> {
        raw_val += 2;
        if (raw_val >= 10) {
            break;
        }
    }
    println("Raw infinite loop result: ", raw_val); // EXPECT: Raw infinite loop result: 10
}

fn main() -> int32 {
    test_conditions();
    test_while_loops();
    test_do_while_loops();
    test_for_in_and_iterators();
    test_raw_and_counted_loops();

    println("ALL 02_CONTROL_FLOW TESTS PASSED"); // EXPECT: ALL 02_CONTROL_FLOW TESTS PASSED
    return 0;
}
