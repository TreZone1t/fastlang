// Valid: array definition
fn main() -> int32 {
    int32 arr[3] = [1, 2, 3];
    float64 arr2[3] = [1.1, 2.2, 3.3];
    char arr3[3] = ['a', 'b', 'c'];
    bool arr4[3] = [true, false, true];

 //  str arr5[3] = "abc";  // not supported yet 

    print(arr[0]);
    print(arr2[0]);
    print(arr3[0]);
    print(arr4[0]);
    return 0;
}
