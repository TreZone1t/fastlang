class MathScope -> {
    public -> {
      int data = 10;  
    }
    handle -> {
        fn add(other: MathScope) -> MathScope {
            MathScope result = new MathScope();
            result.data = this.data + other.data;
            return result;
        }
        fn sub(other: MathScope) -> MathScope {
            MathScope result = new MathScope();
            result.data = this.data - other.data;
            return result;
        }
        fn mul(other: MathScope) -> MathScope {
            MathScope result = new MathScope();
            result.data = this.data * other.data;
            return result;
        }
        fn div(other: MathScope) -> MathScope {
            MathScope result = new MathScope();
            result.data = this.data / other.data;
            return result;
        }
        fn mod(other: MathScope) -> MathScope {
            MathScope result = new MathScope();
            result.data = this.data % other.data;
            return result;
        }
        fn index_access(index: int32) -> int32 {
            return this.data + index;
        }
        fn display() -> int32 {
            return this.data; 
        }
    }
}

enum Direction -> {
    Up,
    Down,
    Left,
    Right
}

impl handle for Direction -> {
    fn display() -> string {
        match (this) -> {
            Direction::Up => { return "Up"; }
            Direction::Down => { return "Down"; }
            Direction::Left => { return "Left"; }
            Direction::Right => { return "Right"; }
            _ => { return "Unknown"; }
        }
    }
}

fn main() -> int32 {
  MathScope a = new MathScope();
  MathScope b = new MathScope();
  MathScope c = a + b;
  MathScope d = a - b;
  MathScope e = a * b;
  MathScope f = a / b;
  MathScope g = a % b;
  println("c.data (10 + 10):");
  println(c.data);
  println("d.data (10 - 10):");
  println(d.data);
  println("e.data (10 * 10):");
  println(e.data);
  println("f.data (10 / 10):");
  println(f.data);
  println("g.data (10 % 10):");
  println(g.data);
  println("Index access a[5]:");
  println(a[5]);

  Direction dir1 = Direction::Up;
  println(dir1);
  return 0;
}
// EXPECT: c.data (10 + 10):
// EXPECT: 20
// EXPECT: d.data (10 - 10):
// EXPECT: 0
// EXPECT: e.data (10 * 10):
// EXPECT: 100
// EXPECT: f.data (10 / 10):
// EXPECT: 1
// EXPECT: g.data (10 % 10):
// EXPECT: 0
// EXPECT: Index access a[5]:
// EXPECT: 15
// EXPECT: Up