// Valid: complete custom scope with label , goto , leave , call , data
custom recursion_chaos -> {
    data -> 0;
    @start -> {
      if (this.data <= 0) {
        this.data -> 1;
      }else{
        this.data -> this.data * 2;
      }
      goto -> @process;
    }
    @process -> {
      if ( this.data % 2 == 0) {
        this.data -> this.data + 1;
      }else{
        leave;
      }
      goto -> @start;
    }
    handle -> {
        fn call () -> int32 {
            goto  -> @start;
        }
        fn leave () -> int32 {
           return this.data;
        }
    }
}

fn main() -> int32 {
  print("Testing recursion_chaos (leave):");
  print(recursion_chaos()); // Should print 1
  return 0;
}
