// Comprehensive Suite 12: Single-line Pipe Lambdas, Arrow Syntax, Inferred Parameters, and Higher-Order Functions

fn apply_op(x: int32, y: int32, op: name<Fn<(int32, int32), int32>>) -> int32 {
    return op(x, y);
}

fn main() -> int32 {
    // 1. Pipe Lambda with explicit arrow signature
    lambda<(int32, int32) -> int32> inl = |x: int32, y: int32| x + y;
    int32 res1 = inl(15, 25);
    println("Pipe lambda result: ", res1); // EXPECT: Pipe lambda result: 40

    // 2. 3-arg Pipe Lambda
    lambda<(int32, int32, int32) -> int32> incl = |x: int32, y: int32, z: int32| x + y + z;
    int32 res2 = incl(10, 20, 30);
    println("Pipe lambda 3 args: ", res2); // EXPECT: Pipe lambda 3 args: 60

    // 3. Pipe Lambda with auto type inference from params
    lambda pipe_mul = |x: int32, y: int32| x * y;
    int32 res3 = pipe_mul(4, 5);
    println("Pipe auto lambda: ", res3); // EXPECT: Pipe auto lambda: 20

    // 4. Pipe Lambda with inferred parameter types from target signature
    lambda<(int32, int32) -> int32> inferred_params = |x, y| x + y;
    int32 res4 = inferred_params(100, 200);
    println("Inferred params pipe lambda: ", res4); // EXPECT: Inferred params pipe lambda: 300

    // 5. Passing lambda to Higher-Order function
    int32 res5 = apply_op(10, 5, inl);
    println("Apply higher-order: ", res5); // EXPECT: Apply higher-order: 15

    println("ALL 12_LAMBDAS TESTS PASSED"); // EXPECT: ALL 12_LAMBDAS TESTS PASSED
    return 0;
}
