// Test 91: Compile-time Validation Block
micro test_micro_in_compile = ()-> {
    @compile::print("test_micro_in_compile");
}
fn test_validation() -> void {
    int32 x = rand<int32>();
    @compile {
        if (x < 0) {
        @compile::print("x is negative");
        }else{
        @compile::print("x is ", x);
        }
        test_micro_in_compile();
    }(x);
}
fn main() -> int32 {
    test_validation();
    println("COMPILE VALIDATION PASSED");
    return 0;
}
