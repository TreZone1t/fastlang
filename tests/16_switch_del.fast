

fn main() -> int32 {
    // Test match
    int32 value = 2;
    int32 x = 0;
    int32 y = 0;
    int32 z = 0;
    
    match (value) -> {
        1 => {
            x = 1;
        }
        2 => {
            y = 2;
        }
        _ => {
            z = 3;
        }
    }
    print(x);
    print(y);
    print(z);
    return 0;
}
