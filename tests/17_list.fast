// Test linked list standard library
import std::list::{list};

fn main() -> void {
    list<int32> li -> [1,2,3,4,5,6];
    li.push(7);
    int32 len = li.size();
    print("length : ", len); // length : 6
    li.push(8);
    len = li.size();
    print("length : ", len);  // length : 7
    for (int32 i = 0; i < len; i = i + 1) -> {
        int32 val = li.pop();
        print("popped value : ", val);
    }
}
