fn main() -> void {
    int32 number = 42;
    int32 my_array[5] = [1,2,3,4,5];

    name safe_ptr = &number; 

    modify<int32> mut_ptr = &number;

    int32* my_heap_array = new int32[1,2,3,4,5];
    
    modify<int32> not_safe_ptr = &my_heap_array[0];
    del not_safe_ptr;
    
    name<int32> bad_ptr = safe_ptr;
    print(*bad_ptr);
    print(*mut_ptr);

    // Dynamic Heap Allocations & Pointer Arithmetic
    int32* ptrarr = new int32[](5); // 5 is the length of the array 
    int32* ptr = new int32(5); // 5 is the value of the int
    modify<int32> mutsmart_ptr2 = ptrarr;   
    modify<int32> mutsmart_ptr3 = ptr; 
    for(int32 i = 0; i < 5; i++){
        *(ptrarr + i) = i;
        print(*(ptrarr + i));
    	print(*(mutsmart_ptr2 + i));
	}
    print(mutsmart_ptr3);
    print(*ptr);
    print(*mutsmart_ptr3);
    del mutsmart_ptr3;
    print(*ptr);
    del ptr;
}