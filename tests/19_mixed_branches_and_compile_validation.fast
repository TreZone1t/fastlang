// Test 19: Mixed branches splitting, compile validation, and compile members

fn i_print_if_has_as_str_only<T>(val: T) -> void {
    if (typeof(val).has_method("as_str")) {
        println(val.as_str());
    } else {
        @compile::throw new Error("not printable :" + typeof(val).as_str());
    }
}

fn i_print_if_has_as_str_and_have_one_branch<T>(val: T) -> void {
    @compile {
        if (!typeof(val).has_method("as_str")) {
            @compile::throw new Error("not printable :" + typeof(val).as_str());
        }
    }(val);
    println(val.as_str());
}

@compile {
    fn i_print_on_compile_time_only<T>(val: T) -> void {
        if (!typeof(val).has_method("as_str")) {
            @compile::throw new Error("not printable :" + typeof(val).as_str());
        } else {
            @compile::print("Comptime print:", val.as_str());
        }
    }
}

fn main() -> int32 {
    i_print_if_has_as_str_only(10);
    i_print_if_has_as_str_and_have_one_branch(42);
    @compile::i_print_on_compile_time_only(100);
    println("MIXED BRANCHES AND COMPILE VALIDATION PASSED");
    return 0;
}
