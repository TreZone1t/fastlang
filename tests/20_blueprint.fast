blueprint Point -> {int32 x; int32 y;};
impl Point -> {
    fn get_x() -> int32 {
        return this.x;
    }
    fn get_y() -> int32 {
        return this.y;
    }
};

fn main() -> int32 {
    Point p;
    p.x = 10;
    p.y = 20;
    int32 x = p.get_x();
    int32 y = p.get_y();
    print(x + y); // EXPECT: 30
    return 0;
}