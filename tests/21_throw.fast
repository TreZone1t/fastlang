// Test 21: Structured Error Handling & Throw Mechanism

machine IHaveThrow {
    @start -> {
        throw new Error("this is an error using handle");
    }
    handle -> {
        fn call() -> void {
            goto @start;
        }
        fn error(e: Error) -> void {
            print("caught error : ", e.message);
        }
    }
}

fn IHaveThrow2() -> void {
    try -> {
        throw new Error("this is an error");
    } catch (e) -> {
        print("caught error : ", e.message);
    }
}

fn main() -> int32 {
    IHaveThrow();
    IHaveThrow2();
    return 0;
}