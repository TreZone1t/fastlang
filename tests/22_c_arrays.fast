// 22_c_arrays.fs

int32 arr[3] = [1, 2, 3];
float64 arr2[3] = [1.1, 2.2, 3.3];
char arr3[6] = "hello";
bool arr4[3] = [true, false, true];

fn main() -> int32 {
    int32 size = arr.length;
    print("Array size: ", size);
    for (int32 i = 0; i < arr.length; i++) {
        print(arr[i]);
    }
    return 0;
}
