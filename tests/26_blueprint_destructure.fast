blueprint Point -> {
    int32 x;
    int32 y;
};

fn IreturnPoint() -> Point {
    return Point { x = 10, y = 20 };
}

fn main() -> int32 {
    {int32 x; int32 y;} = IreturnPoint();
    println(x); // EXPECT: 10
    println(y); // EXPECT: 20

    const {int32 a; int32 b;} = IreturnPoint();
    println(a); // EXPECT: 10
    println(b); // EXPECT: 20

    Point {c, d} = IreturnPoint();
    println(c); // EXPECT: 10
    println(d); // EXPECT: 20

    const Point {e, f} = IreturnPoint();
    println(e); // EXPECT: 10
    println(f); // EXPECT: 20
    Point {m, n} = Point { x = 30, y = 40 };
    println(m); // EXPECT: 30
    println(n); // EXPECT: 40
    Point p = Point { x = 50, y = 60 };
    println(p.x); // EXPECT: 50
    println(p.y); // EXPECT: 60
    return 0;
}
