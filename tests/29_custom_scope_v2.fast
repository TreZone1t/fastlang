// Test Custom Scope v2 Features:
// 1. Direct labels without 'enable' or 'add label'
// 2. Data state container
// 3. Private fields & constructor
//there a bug we need to allow initialization throw this scope obj
machine ConfigurableStateMachine -> {
    @start -> {
        this.data =this.data + this.step;
        if (this.data >= this.max_val) {
            leave;
        }
        goto -> @start;
    }

    handle -> {
        fn call(step: int32, max_val: int32) -> int32 {
            this {
               int32 data;
               int32 step;
               int32 max_val;
            }
            this.step = step;
            this.max_val = max_val;
            goto -> @start;
        }
        fn leave() -> int32 {
            return this.data;
        }
    }
}

fn main() -> int32 {
    int32 result = ConfigurableStateMachine(3, 10);
    print("Final SM Data: ", result); // EXPECT: Final SM Data: 12

    return 0;
}
