// Test 36: micro declarations, execution, and clean keyword handles

micro Ilooped = (i: modify<int32>) -> {
    i -= 1;
};

micro double_it = (val: int32) -> int32 {
    return val * 2;
};

custom CleanScope -> {
    data -> 100;
    @start -> {
        this.data -> this.data + 50;
        leave;
    }
    handle -> {
        fn call() -> int32 {
            goto @start;
        }
        fn leave() -> int32 {
            return this.data;
        }
        fn drop() -> void {
            print("CleanScope dropped cleanly");
        }
    }
}

block<int32> compute_sum -> {
    int32 total = 0;
    for (int32 k = 1; k <= 5; k = k + 1) {
        total = total + k;
    }
    return total;
}

fn main() -> int32 {
    int32 count = 5;
    Ilooped(&count);
    Ilooped(&count);
    print("Count after micro loops: ", count);

    int32 doubled = double_it(21);
    print("Doubled value from micro: ", doubled);

    int32 scope_res = CleanScope();
    print("CleanScope result: ", scope_res);

    int32 block_sum = compute_sum();
    print("Block sum result: ", block_sum);
    print("Block internal total: ", compute_sum.total);

    return 0;
}
