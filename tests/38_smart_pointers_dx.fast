// Test 38: Smart pointers ergonomics (name, modify, copy) and target value/address inspection

fn increment_val(m: modify<int32>) -> void {
    m += 10;
}

fn main() -> int32 {
    int32 num = 50;
    
    name<int32> read_ptr = &num;
    print("Value via name: ", read_ptr);
    print("Value via deref: ", *read_ptr);

    modify<int32> mod_ptr = &num;
    increment_val(mod_ptr);
    print("Value after increment: ", num);

    mod_ptr += 5;
    print("Value after direct +=: ", mod_ptr);

    print("Target pointee address via &*: ", &*mod_ptr);
    print("Target pointee address via *(&*: ", *(*&mod_ptr));

    return 0;
}
