// Test: Direct Enum Variant & Named Struct Destructuring

blueprint Point -> {
    int32 x;
    int32 y;
};

fn make_point(a: int32, b: int32) -> Point {
    return Point { x = a, y = b };
}

fn main() -> int32 {
    // 1. Named Blueprint Destructuring without types
    Point { px, py } = make_point(10, 20);
    print(px); // EXPECT: 10
    print(py); // EXPECT: 20

    // 2. Const Named Blueprint Destructuring
    const Point { cx, cy } = make_point(30, 40);
    print(cx); // EXPECT: 30
    print(cy); // EXPECT: 40

    return 0;
}
