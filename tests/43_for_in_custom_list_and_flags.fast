// Test: For-in loop over custom class with iterator / next handles and built-in flags

import std::list::{list};

class CustomCounter -> {
    private -> {
        int32 current = 0;
        int32 max = 3;
    }
    public -> {
        fn set_max(m: int32) -> void {
            this.max = m;
        }
    }
    handle -> {
        fn iterator() -> void {
            this.current = 1;
        }
        fn next() -> Option<int32> {
            if (this.current > this.max) {
                return None;
            }
            int32 val = this.current;
            this.current = this.current + 1;
            return Some(val);
        }
    }
    constructor -> {
        init(m: int32) -> {
            this.current = 1;
            this.max = m;
        }
    }
}

fn main() -> int32 {
    // 1. For-in loop on standard list
    list<int32> my_list -> [10, 20, 30];
    for x in my_list -> {
        println(x);
    }
    // EXPECT: 30
    // EXPECT: 20
    // EXPECT: 10

    // 2. For-in loop on custom class
    CustomCounter counter = new CustomCounter(3);
    for item in counter -> {
        println(item);
    }
    // EXPECT: 1
    // EXPECT: 2
    // EXPECT: 3

    return 0;
}

