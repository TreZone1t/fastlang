// Test 47: Memory Lifecycle (copy -> modify), Pointer Rebinding (name vs modify)

fn main() -> int32 {
    int32 original = 100;

    // 1. Weak pointer 'name' can be rebound via 'set'
    name<int32> ptr = &original;
    print("Initial ptr via name: ", *ptr);

    int32 second = 200;
    set ptr = &second;
    print("Rebound ptr via name: ", *ptr);

    // 2. Intermediate copy creates an owned modify buffer
    copy<int32> cloned = original;
    print("Cloned value: ", cloned);

    return 0;
}
