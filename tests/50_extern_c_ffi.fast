import std::string;
import @c "math.h";
import @c "stdlib.h";

extern @c {
    fn sqrt(x: float64) -> float64;
}

extern @c fn abs(n: int32) -> int32;

fn main() -> int32 {
    float64 val = 144.0;
    float64 root = sqrt(val);
    print(root);

    int32 neg = -42;
    int32 pos = abs(neg);
    print(pos);

    return 0;
}
