import std::string;

class BaseService -> {
    public -> {
        string title = "Base";
    }

    handle -> {
        fn display() -> string {
            return "BaseService::display";
        }
    }
}

class CustomService extends BaseService -> {
    public -> {
        string version = "2.0";
    }

    handle -> {
        fn display() -> string {
            return "CustomService::display (Overridden!)";
        }
    }
}

fn main() -> int32 {
    BaseService b = new BaseService();
    print(b.display());

    CustomService c = new CustomService();
    print(c.display());

    return 0;
}
