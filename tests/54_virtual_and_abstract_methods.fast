import std::string;

class Animal -> {
    public -> {
        virtual fn speak() -> string {
            return "Animal sound";
        }
        abstract fn get_kind() -> string;
    }
}

class Dog extends Animal -> {
    public -> {
        fn speak() -> string {
            return "Woof!";
        }
        fn get_kind() -> string {
            return "Canine";
        }
    }
}

fn main() -> int32 {
    Dog dog = new Dog();
    print(dog.speak());
    print(dog.get_kind());

    return 0;
}
