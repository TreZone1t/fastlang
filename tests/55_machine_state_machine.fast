// Test 55: Pure State Machine ('machine' construct)
// Features:
// 1. @init runs once
// 2. Persistent variables (count, max_limit) inside labels
// 3. goto -> @label transitions
// 4. call() and leave() handles

machine CounterMachine -> {
    @init -> {
        int32 count = 0;
        int32 max_limit = 5;
        goto -> @step;
    }

    @step -> {
        count = count + 1;
        if (count >= max_limit) {
            goto -> @finish;
        }
        goto -> @step;
    }

    @finish -> {
        leave;
    }

    handle -> {
        fn call() -> int32 {
            goto -> @init;
        }
        fn leave() -> int32 {
            return this.count;
        }
    }
}

fn main() -> int32 {
    int32 result = CounterMachine();
    print("Final Machine Count: ", result);
    return 0;
}
// EXPECT: Final Machine Count: 5
