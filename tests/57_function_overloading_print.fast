// Test 57: Function Overloading and standard print() across multiple types

fn custom_add(a: int32, b: int32) -> int32 {
    return a + b;
}

fn custom_add(a: float64, b: float64) -> float64 {
    return a + b;
}

fn main() -> int32 {
    print("Testing string print");
    print(42);
    print(1000000000000);
    print(3.14159);
    print(true);
    print(false);

    int32 i_res = custom_add(10, 20);
    print(i_res);

    float64 f_res = custom_add(1.5, 2.5);
    print(f_res);

    return 0;
}
