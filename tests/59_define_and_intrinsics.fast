// Test 59: define keyword for type aliases and constants + typeof, sizeof, and type variables
import std;

define UserID = int32;
define MAX_COUNT = 100;

struct Vector {
    public {
        int32 x = 10;
    }
    handle -> {
        fn display() -> void {
            print("Vector2D");
        }
    }
}

fn main() -> int32 {
    UserID id = 42;
    println(id); // EXPECT: 42

    int32 limit = MAX_COUNT;
    println(limit); // EXPECT: 100

    name<Vector> v = new Vector();
    println(v); // EXPECT: Vector2D

    // Testing sizeof in conditions and expressions
    if (sizeof(id) == 4) {
        println("sizeof check passed"); // EXPECT: sizeof check passed
    }

    // Testing typeof directly in conditions comparing against int32
    if (typeof(id) == int32) {
        println("typeof check passed"); // EXPECT: typeof check passed
    }

    // Storing typeof in a 'type' variable
    type t = typeof(id);
    if (t == int32) {
        println("type variable check passed"); // EXPECT: type variable check passed
    }

    return 0;
}
