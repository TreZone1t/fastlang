//text handle for overridden fns
fn IHandleThrowInMe(m : str)-> void {
throw new Error(m);
}
fn IHandleThrowInMe()-> void {
throw new Error("I worked as planed");
}
impl handle for IHandleThrowInMe {
    fn error(e : Error) -> void {
        print("caught error : ", e.message);
    }
}
fn main() -> int {
IHandleThrowInMe("I hi from 1!"); //terminate called after throwing an instance of 'fast_std::Error'
IHandleThrowInMe();
return 0;
}