// Test 63: void values as () and void, and for-in with micro execution

fn test_void_returns() -> void {
    return ();
}

fn test_void_keyword() -> void {
    return void;
}

fn test_empty_return() -> void {
    return;
}

fn main() -> int32 {
    test_void_returns();
    test_void_keyword();
    test_empty_return();
    println("void tests passed"); // EXPECT: void tests passed

    int count = 0;
    for (int x in range(10)) {
        count += 1;
        if (count >= 5) {
            stop();
        }
    }
    println("count after stop: ", count); // EXPECT: count after stop: 5

    return 0;
}
