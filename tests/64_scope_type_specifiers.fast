// Test 64: Unified Scope & Callable Type Specifiers

fn double_it(x: int32) -> int32 {
    return x * 2;
}

class Point {
    public -> {
        int32 x = 10;
        int32 y = 20;
    }
}

my_blk -> int32 {
    return 42;
}

fn main() -> int32 {
    name<fn<(int32), int32>> f1 = &double_it;
    println(f1(5)); // EXPECT: 10

    name<fn::double_it<(int32), int32>> f2 = &double_it;
    println(f2(15)); // EXPECT: 30

    name<class::Point> p = new Point();
    println(p.x); // EXPECT: 10
    println(p.y); // EXPECT: 20

    name<block<int32>> b = &my_blk;
    println(b()); // EXPECT: 42

    return 0;
}
