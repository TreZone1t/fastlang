// Test 65: Anonymous Functions and Immediate Invocation (IIFE)

fn main() -> int32 {
    // 1. Immediate invocation of lambda with parameters and return
    int32 sum = (fn(a: int32, b: int32) -> int32 {
        return a + b;
    })(15, 25);
    println(sum); // EXPECT: 40

    // 2. Direct statement IIFE
    fn(x: int32) -> void {
        println("direct iife: ", x); // EXPECT: direct iife: 99
    }(99);

    return 0;
}
