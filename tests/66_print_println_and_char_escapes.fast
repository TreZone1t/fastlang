// Test 66: print vs println and character escape sequences

fn main() -> int32 {
    // 1. Test escape characters in chars
    char newline_char = '\n';
    char tab_char = '\t';
    char quote_char = '\'';
    char backslash = '\\';

    print("A");
    print(tab_char);
    print("B");
    print(newline_char); // Should go to next line

    // 2. Test println
    println("Line 1 from println");
    println("Line 2 from println");

    // 3. Test string escapes
    println("Quotes: \"hello\" and backslash: \\");

    return 0;
}
