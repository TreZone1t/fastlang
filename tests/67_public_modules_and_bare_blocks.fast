// Test 67: public modules, bare block syntax, local imports, and string concatenation

public math_ops {
    public fn multiply(a: int32, b: int32) -> int32 {
        return a * b;
    }
}

fn main() -> int32 {
    // 1. Local import inside function
    import std::string;

    // 2. Call function from public block / module
    int32 res = math_ops::multiply(6, 7);
    println("6 * 7 = ", res);

    // 3. Bare block without 'block' keyword
    counter_block -> int32 {
        return 100;
    };
    println("Counter value: ", counter_block());

    // 4. Adjacent string auto-concatenation
    println("Part 1: " "Hello " "from " "concatenated strings!");

    return 0;
}
