// Test 70: Walrus Operator (:=), Type Inference, and Undefined Declarations
import std;

class Point -> {
    public -> {
        int32 x = 0;
        int32 y = 0;
    }
}

fn main() -> int32 {
    // 1. Walrus variable declaration (inferred int32)
    x := 42;
    println("x = ", x); // EXPECT: x = 42

    // 2. Walrus const declaration (inferred string)
    const best := "fastlang";
    println("best = ", best); // EXPECT: best = fastlang

    // 3. Walrus object instantiation
    p := new Point();
    p.x = 10;
    p.y = 20;
    println("Point: x=", p.x, ", y=", p.y); // EXPECT: Point: x=10, y=20

    // 4. Undefined declaration on explicitly typed variable
    int32 uninit = undefined;
    uninit = 100;
    println("uninit after assign = ", uninit); // EXPECT: uninit after assign = 100

    println("all walrus checks passed"); // EXPECT: all walrus checks passed
    return 0;
}
