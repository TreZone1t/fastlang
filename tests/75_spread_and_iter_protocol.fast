// Test 75: Array Spread Operator (...), Iterator Protocol (iter/next), and Copy Handle

class Counter -> {
    private -> {
        int32 current = 0;
        int32 max = 3;
    }
    public -> {
        fn set_max(m: int32) -> void {
            this.max = m;
        }
    }
    handle -> {
        fn iter() -> void {
            this.current = 1;
        }
        fn next() -> Option<int32> {
            if (this.current > this.max) {
                return None;
            }
            int32 val = this.current;
            this.current = this.current + 1;
            return Some(val);
        }
    }
    constructor -> {
        init(m: int32) -> {
            this.current = 1;
            this.max = m;
        }
    }
}

class ValueHolder -> {
    public -> {
        int32 value = 0;
    }
    handle -> {
        fn copy() -> ValueHolder {
            ValueHolder cloned = new ValueHolder(this.value + 100);
            return cloned;
        }
    }
    constructor -> {
        init(v: int32) -> {
            this.value = v;
        }
    }
}

fn main() -> int32 {
    // 1. Test Spread Operator in Array Literals
    int a[] = [2, 3, 4];
    int b[] = [1, ...a, 5, 6];
    for x in b {
        print(x);
        print(" ");
    }
    println("");

    int c[] = [7, 8];
    int all[] = [...a, ...c];
    for x in all {
        print(x);
        print(" ");
    }
    println("");

    // 2. Test Custom Class with 'iter' handle in for-in loop
    Counter cnt = new Counter(4);
    for item in cnt {
        print(item);
        print(" ");
    }
    println("");

    // 3. Test Custom Class with 'copy' handle
    ValueHolder orig = new ValueHolder(42);
    copy<ValueHolder> cloned = orig;
    println(cloned.value);

    // 4. Test std::range helper functions
    int r[] = range(1, 4);
    for n in r {
        print(n);
        print(" ");
    }
    println("");

    return 0;
}
