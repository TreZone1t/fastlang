// Test 76: Comprehensive Enum Variants (Unit, Tuple, Struct) & Pattern Matching Destructuring

enum Command {
    Reset,
    Stop,
    Move(int32, int32),
    Speak(str),
    Resize {
        int32 width;
        int32 height;
    }
}

fn execute_command(cmd: Command) -> int32 {
    int32 result = 0;
    match (cmd) -> {
        Command::Reset => {
            print("Command: Reset");
            result = 1;
        }
        Command::Stop => {
            print("Command: Stop");
            result = 2;
        }
        Command::Move(x, y) => {
            print("Command: Move to x=", x, ", y=", y);
            result = x + y;
        }
        Command::Speak(msg) => {
            print("Command: Speak '", msg, "'");
            result = 3;
        }
        Command::Resize { width, height } => {
            print("Command: Resize to ", width, "x", height);
            result = width * height;
        }
        _ => {
            print("Unknown command");
            result = -1;
        }
    }
    return result;
}

fn main() -> int32 {
    // 1. Unit Variant
    Command c1 = Command::Reset;
    int32 r1 = execute_command(c1);
    print(" Result 1: ", r1);
    println("");

    Command c2 = Command::Stop;
    int32 r2 = execute_command(c2);
    print(" Result 2: ", r2);
    println("");

    // 2. Tuple Variant
    Command c3 = Command::Move(50, 70);
    int32 r3 = execute_command(c3);
    print(" Result 3: ", r3);
    println("");

    Command c4 = Command::Speak("FastLang rocks");
    int32 r4 = execute_command(c4);
    print(" Result 4: ", r4);
    println("");

    // 3. Struct Variant
    Command c5 = Command::Resize { width = 10, height = 20 };
    int32 r5 = execute_command(c5);
    print(" Result 5: ", r5);
    println("");

    return 0;
}
