// Test 77: For-in loop with modify<T> and stop micro in iterator handles

class NumberList -> {
    private -> {
        int32[5] items = [10, 20, 30, 40, 50];
        int32 count = 0;
        int32 limit = 3;
    }
    public -> {
        fn set_limit(l: int32) -> void {
            this.limit = l;
        }
    }
    handle -> {
        fn iterator() -> void {
            this.count = 0;
        }
        fn next() -> modify<int32 , micro::stop<(),>> {
            if (this.count >= this.limit) {
                return stop;
            }
            this.count += 1;
            return this.items[this.count - 1];
        }
    }
    constructor -> {
        init(l: int32) -> {
            this.count = 0;
            this.limit = l;
        }
    }
}

class StepCounter -> {
    private -> {
        int32 current = 0;
        int32 max_val = 0;
    }
    handle -> {
        fn iter() -> void {
            this.current = 100;
        }
        fn next() -> Option<int32> {
            if (this.current > this.max_val) {
                return stop;
            }
            int32 val = this.current;
            this.current += 100;
            return Some(val);
        }
    }
    constructor -> {
        init(m: int32) -> {
            this.current = 100;
            this.max_val = m;
        }
    }
}

fn main() -> int32 {
    // 1. Iterate over NumberList returning modify<int32> and stop
    NumberList list1 = new NumberList(3);
    for x in list1 -> {
        println(x);
    }
    // EXPECT: 10
    // EXPECT: 20
    // EXPECT: 30

    // 2. Iterate again to verify iterator reset
    list1.set_limit(2);
    for y in list1 -> {
        println(y);
    }
    // EXPECT: 10
    // EXPECT: 20

    // 3. StepCounter returning Option with stop
    StepCounter steps = new StepCounter(250);
    for s in steps -> {
        println(s);
    }
    // EXPECT: 100
    // EXPECT: 200

    return 0;
}
