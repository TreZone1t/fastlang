import std;

fn main() -> void {
    char c1 = '5';
    char c2 = 'a';
    char c3 = 'Z';
    char c4 = ' ';

    bool d1 = c1.is_digit();
    bool d2 = c2.is_digit();
    println(d1);
    println(d2);

    bool a1 = c1.is_alpha();
    bool a2 = c2.is_alpha();
    println(a1);
    println(a2);

    char up = c2.to_upper();
    char low = c3.to_lower();
    println(up);
    println(low);

    bool w1 = c4.is_whitespace();
    println(w1);
}
