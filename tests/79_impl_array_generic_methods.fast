import std;

fn main() -> void {
    int32[] nums = [10, 20, 30];
    bool empty = nums.is_empty();
    println(empty);

    Option<int32> f = nums.first();
    match f {
        Some(val) => {
            println(val);
        }
        None => {
            println(0);
        }
    }

    Option<int32> l = nums.last();
    match l {
        Some(val) => {
            println(val);
        }
        None => {
            println(0);
        }
    }

    char[] empty_arr = [];
    bool empty2 = empty_arr.is_empty();
    println(empty2);
}
