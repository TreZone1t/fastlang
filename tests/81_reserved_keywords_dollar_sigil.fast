// Test 81: Dollar Sigil ($) for Reserved Keywords in Handle Blocks & Method Names

class CustomException -> {
    public -> {
        str detail = "";
    }

    constructor -> {
        init(msg: str) -> {
            this.detail = msg;
        }
    }

    handle -> {
        fn $throw() -> CustomException {
            return this;
        }
        fn $display() -> str {
            return this.detail;
        }
    }
}

machine FlowController {
    @start -> {
        goto @done;
    }
    @done -> {
        leave;
    }
    handle -> {
        fn call() -> void {
            goto @start;
        }
        fn leave() -> void {
            return;
        }
    }
}

fn main() -> int32 {
    CustomException ex = new CustomException("Custom error triggered");
    print("Exception detail: ", ex.detail);
    println("");

    FlowController();
    print("Flow executed successfully");
    println("");

    return 0;
}
