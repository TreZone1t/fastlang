// Test 82: @compile Block from std and fastlang_str

class SystemConfig -> {
    public -> {
        str version = "1.0.0";
    }
}

fn main() -> int32 {
    SystemConfig cfg = new SystemConfig();
    print("Config version: ", cfg.version);
    println("");

    str msg = "FastLang Compile Tools";
    print("Msg: ", msg);
    println("");

    return 0;
}
