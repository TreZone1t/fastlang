// Test 86: State Machine with vertical sequential continue and implicit leave

machine StepperMachine -> {
    @first -> {
        print("At @first");
        continue; // Must jump sequentially to @second
    }

    @second -> {
        print("At @second");
        // No goto, break, or continue here -> must implicitly leave, NO fallthrough to @third!
    }

    @third -> {
        print("ERROR: Should not reach @third!");
        goto @done;
    }

    @done -> {
        leave;
    }

    handle -> {
        fn call() -> int32 {
            goto @first;
        }
        fn leave() -> int32 {
            print("Implicit leave executed cleanly");
            return 42;
        }
    }
}

fn main() -> int32 {
    int32 res = StepperMachine();
    print("Machine result: ", res);
    return 0;
}
