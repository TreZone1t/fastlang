// Test 88: Testing del statement and drop handles on class and struct

class Resource -> {
    public -> {
        int32 id = 101;
    }
    constructor -> {
        init(val: int32) -> {
            this.id = val;
        }
    }
    handle -> {
        fn drop() -> void {
            println("Resource ", this.id, " dropped!");
        }
    }
}

struct StackResource -> {
    public -> {
        int32 tag = 999;
    }
    handle -> {
        fn drop() -> void {
            println("StackResource ", this.tag, " dropped!");
        }
    }
}

fn test_auto_scope() -> void {
    StackResource s_auto;
}

fn main() -> int32 {
    Resource res = new Resource(42);
    del res;

    StackResource s;
    del s;

    test_auto_scope();

    return 0;
}
