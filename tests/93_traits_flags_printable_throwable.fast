// Test 93: Testing compilable, printable, throwable trait flags

struct PrintableItem -> {
    public -> {
        int32 id = 100;
    }
    handle -> {
        fn display() -> str {
            return "PrintableItem #100";
        }
    }
}

struct RawItem -> {
    public -> {
        int32 id = 200;
    }
}

fn main() -> int32 {
    PrintableItem p;
    RawItem r;
    int32 x = 42;

    bool p_printable = p.printable;
    bool r_printable = r.printable;
    bool x_printable = x.printable;

    println("p.printable: ", p_printable);
    println("r.printable: ", r_printable);
    println("x.printable: ", x_printable);
    println("Printing p: ", p);

    return 0;
}
